# URL du backend vue par le navigateur.
# Production (une seule origine derrière le rewrite /api de next.config.mjs) : NE PAS la définir —
# le navigateur appelle alors /api/... sur le domaine du site, et le serveur Next relaie vers
# BACKEND_INTERNAL_URL (défaut http://localhost:8080).
# BACKEND_INTERNAL_URL=http://localhost:8080
# En local sur le PC : http://localhost:8080
# Depuis le réseau LAN (téléphone, autre PC) : http://VOTRE_IP:8080 (ipconfig → IPv4 Wi‑Fi)
NEXT_PUBLIC_API_URL=http://localhost:8080

# URL publique du site (images Open Graph / partage sur les réseaux sociaux).
# En production : https://votre-domaine.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional TURN server for WebRTC calls behind strict NAT/firewalls.
# NEXT_PUBLIC_TURN_URL=turn:your-turn-server:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# OAuth redirect URIs are configured on the backend (see backend/.env.example).
