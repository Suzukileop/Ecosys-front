# URL du backend vue par le navigateur.
# En local sur le PC : http://localhost:8080
# Depuis le réseau LAN (téléphone, autre PC) : http://VOTRE_IP:8080 (ipconfig → IPv4 Wi‑Fi)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional TURN server for WebRTC calls behind strict NAT/firewalls.
# NEXT_PUBLIC_TURN_URL=turn:your-turn-server:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# OAuth redirect URIs are configured on the backend (see backend/.env.example).
