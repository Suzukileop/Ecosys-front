{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "lan:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/lan-setup.ps1",
    "lan:reset": "powershell -ExecutionPolicy Bypass -File ./scripts/lan-reset.ps1",
    "tunnel": "powershell -ExecutionPolicy Bypass -File ./scripts/tunnel.ps1",
    "dev:webpack": "next dev --webpack",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "build": "npm run generate:tool-icons && next build",
    "build:webpack": "npm run generate:tool-icons && next build --webpack",
    "generate:tool-icons": "node scripts/generate-tool-tech-icons-manifest.mjs",
    "build:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build",
    "start": "next start",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "report:route-sizes": "node scripts/report-route-js-sizes.mjs"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hookform/resolvers": "^5.2.2",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@stomp/stompjs": "^7.0.0",
    "axios": "^1.16.0",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
